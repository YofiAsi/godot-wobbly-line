; Engine configuration file.
; Godot Wobbly Shapes — hand-drawn "wobbly" shape addon demo project.
; Targets Godot 4.6.

config_version=5

[application]

config/name="Godot Wobbly Shapes"
config/description="Demo project for the wobbly_shapes addon: hand-drawn, animation-ready wobbly outlines for Control and Node2D."
run/main_scene="res://demo/wobble_demo.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/wobbly_shapes/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
